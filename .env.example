# Drizzle
# Replace with your DB credentials!
DATABASE_URL="libsql://db-name-user.turso.io"
# A local DB can also be used in dev as well
# DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

# Clerk — get these from https://dashboard.clerk.com → API Keys
# Use Clerk for sign-in / sign-up only. Disable Organizations in the
# Clerk Dashboard (Organizations → off, or Membership optional) so users
# are not forced through the "choose organization" task. Workspaces are
# owned by the app, not by Clerk.
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxx"

# Resend — workspace invite emails
# Prototype can use onboarding@resend.dev until a domain is verified.
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM="expenseur <onboarding@resend.dev>"
